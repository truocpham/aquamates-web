{
  "name": "aquamates-web",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --web",
    "web": "expo start --web",
    "build": "expo export -p web",
    "lint": "eslint .",
    "test": "jest",
    "e2e:build": "EXPO_PUBLIC_SUPABASE_URL=https://e2e.supabase.co EXPO_PUBLIC_SUPABASE_ANON_KEY=e2e-anon-key expo export -p web --output-dir dist-e2e --clear",
    "e2e": "npm run e2e:build && playwright test"
  },
  "dependencies": {
    "@expo-google-fonts/baloo-2": "^0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.105.0",
    "expo": "^58.0.20",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.0",
    "expo-router": "~58.0.27",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.12",
    "react-test-renderer": "19.3.0",
    "typescript": "^6.0.3"
  }
}
